# Create a key at https://bigmodel.cn/usercenter/proj-mgmt/apikeys
# Fill this locally; do not commit real keys. LLM_API_KEY overrides this if set.
ZHIPU_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=max
LLM_THINKING_ENABLED=true
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=180
RAG_EMBEDDING_PROVIDER=hashing
MEMORY_EMBEDDING_PROVIDER=hashing
MEMORY_TOP_K=5
MEMORY_TOKEN_BUDGET=1000
MEMORY_LLM_EXTRACTION=true
REACT_MAX_STEPS=4
# Set true for isolated offline UI/protocol tests.
LLM_DISABLED=false
CASEFORGE_DATA_DIR=./data
